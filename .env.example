# Copia este archivo como .env.local y llena los valores.
# Ninguna de estas variables se expone al navegador.

# URL pública del sitio (sin diagonal al final). Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.vantgardsystems.com

# Agente IA (Google Gemini, plan gratuito): https://aistudio.google.com/apikey
# Sin esta key el chat funciona en modo demo con respuestas predefinidas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Correos (Resend): https://resend.com/api-keys
# Sin esta key los formularios abren WhatsApp con el mensaje.
RESEND_API_KEY=
# Remitente verificado en Resend y destinatario de los avisos.
CONTACT_FROM="Vantgard Systems <web@vantgardsystems.com>"
CONTACT_TO=erick.castro@vantgardsystems.com

# Meta de verificación de Google Search Console (solo el código).
GOOGLE_SITE_VERIFICATION=
